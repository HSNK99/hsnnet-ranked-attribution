{
  "algorithm": "MiPOD",
  "payload": "0.4bpp",
  "root_dir": "${BOSSBASE_ROOT}",
  "cover_dir": "${BOSSBASE_ROOT}/cover",
  "stego_root": "${BOSSBASE_ROOT}/stego",
  "stego_dir": "${BOSSBASE_ROOT}/stego/MiPOD/0.4bpp/stego",
  "out_root": ".\\outputs_acc_plus_all_algorithms_04bpp",
  "out_dir": ".\\outputs_acc_plus_MiPOD_only_04bpp\\outputs_template_MiPOD_acc_plus",
  "image_size": 256,
  "train_ratio": 0.7,
  "val_ratio": 0.15,
  "test_ratio": 0.15,
  "batch_size": 32,
  "num_workers": 0,
  "pin_memory": true,
  "epochs": 150,
  "lr": 8e-05,
  "weight_decay": 0.0001,
  "warmup_epochs": 5,
  "min_lr_ratio": 0.01,
  "patience": 20,
  "early_stop_start_epoch": 70,
  "grad_clip": 1.0,
  "ema_decay": 0.999,
  "seed": 42,
  "use_amp": true,
  "use_resize": true,
  "save_plots": true,
  "tlu_threshold": 3.0,
  "sigma_window": 3,
  "normalize_kernels": true,
  "frontend_trainable": false,
  "use_augmentation": true,
  "d4_repeat_factor": 2,
  "label_smoothing": 0.02,
  "use_final_tta": true,
  "tta_d4_count": 8,
  "matched_pairs": 10000,
  "train_pairs": 7000,
  "val_pairs": 1500,
  "test_pairs": 1500
}
